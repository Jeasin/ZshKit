#!/bin/zsh

# 遍历所有传入的参数，把替身/软链接替换为真实路径
args=()
for arg in "$@"; do
  # 如果参数对应的文件存在
  if [[ -e "$arg" ]]; then
    # 1. macOS 替身：利用 AppleScript 解析真实路径
    if [[ -f "$arg" ]] && xattr -p com.apple.FinderInfo "$arg" &>/dev/null; then
      real_path=$(osascript -e "tell application \"Finder\" to set p to (original item of (POSIX file \"$arg\" as alias)) as alias" -e "POSIX path of p" 2>/dev/null)
      [[ -n "$real_path" ]] && arg="$real_path"

    # 2. 软链接：利用 Zsh 的 :A 修饰符直接穿透拿到真实路径
    elif [[ -L "$arg" ]]; then
      arg="${arg:A}"
    fi
  fi
  args+=("$arg")
done

# 将解析后的参数数组传递给原生的 command bat
exec command bat "${args[@]}"
